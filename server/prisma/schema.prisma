model BioPage {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  slug              String    @db.VarChar(100)
  title             String    @default("My Bio Page") @db.VarChar(255)
  description       String?   @db.Text
  status            String    @default("draft") @db.VarChar(50) // 'draft' | 'published' | 'archived'
  isPrimary         Boolean   @default(false) @map("is_primary")
  customDomain      String?   @unique @map("custom_domain") @db.VarChar(255)
  templateId        String    @default("creator-basic") @map("template_id") @db.VarChar(100)
  templateVersion   String    @default("1.0.0") @map("template_version") @db.VarChar(50)

  // Enterprise JSONB Payloads (Blocks, Theme & SEO settings)
  draftBlocks       Json      @default("[]") @map("draft_blocks")
  draftTheme        Json      @default("{}") @map("draft_theme")
  publishedSnapshot Json?     @map("published_snapshot")
  settings          Json      @default("{}") @map("settings")

  // Real-time Aggregate Performance Metrics
  viewCount         Int       @default(0) @map("view_count")
  clickCount        Int       @default(0) @map("click_count")
  uniqueVisitors    Int       @default(0) @map("unique_visitors")

  // Timestamps
  publishedAt       DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyticsEvents   BioAnalyticsEvent[]
  subscribers       BioSubscriber[]
  dailyStats        BioDailyStat[]

  @@unique([userId, slug])
  @@index([userId])
  @@index([slug])
  @@map("bio_pages")
}


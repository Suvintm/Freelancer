generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username                  String?                    @unique @db.VarChar(100)
  email                     String                     @unique @db.VarChar(255)
  password_hash             String?                    @map("password_hash")
  role                      UserRole                   @default(suvix_user)
  auth_provider             AuthProvider?              @default(local) @map("auth_provider")
  google_id                 String?                    @unique @map("google_id") @db.VarChar(255)
  is_verified               Boolean                    @default(false) @map("is_verified")
  is_email_verified         Boolean                    @default(false) @map("is_email_verified")
  is_banned                 Boolean                    @default(false) @map("is_banned")
  ban_reason                String?                    @map("ban_reason")
  is_onboarded              Boolean                    @default(false) @map("is_onboarded")
  created_at                DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at                DateTime                   @default(now()) @map("updated_at") @db.Timestamptz(6)
  token_version             Int                        @default(0) @map("token_version")
  comment_likes             CommentLike[]
  comments                  Comment[]                  @relation("UserComments")
  communities_owned         Community[]                @relation("CommunityOwner")
  memberships               CommunityMember[]
  communityMessageReactions CommunityMessageReaction[]
  community_messages        CommunityMessage[]
  media                     Media[]
  media_user_tags           MediaUserTag[]
  received_messages         Message[]                  @relation("MessageReceiver")
  sent_messages             Message[]                  @relation("MessageSender")
  triggeredNotifications    Notification[]             @relation("TriggeredNotifications")
  notifications             Notification[]             @relation("UserNotifications")
  paymentsAsClient          Payment[]                  @relation("ClientPayments")
  paymentsAsEditor          Payment[]                  @relation("EditorPayments")
  poll_likes                PollLike[]
  poll_responses            PollResponse[]
  polls                     Poll[]
  post_collaborations       PostCollaborator[]
  post_likes                PostLike[]
  post_mentions             PostMention[]
  posts                     Post[]
  pushTokens                PushToken[]
  recommendation_logs       RecommendationLog[]
  reel_likes                ReelLike[]
  reels                     Reel[]
  refundsAsClient           Refund[]                   @relation("ClientRefunds")
  refundsAsEditor           Refund[]                   @relation("EditorRefunds")
  stories                   Story[]
  story_views               StoryView[]
  subscriptions             Subscription[]
  content_affinities        UserContentAffinity[]
  follows                   UserFollow[]               @relation("Follower")
  following                 UserFollow[]               @relation("Following")
  profile                   UserProfile?
  stats                     UserStats?
  walletTransactions        WalletTransaction[]
  withdrawalRequests        WithdrawalRequest[]
  youtube_post_likes        YoutubePostLike[]
  youtube_posts             YoutubePost[]
  youtubeProfiles           YouTubeProfile[]
  youtube_videos            YouTubeVideo[]

  @@index([role])
  @@index([is_onboarded])
  @@map("users")
}

model UserProfile {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String             @unique @map("user_id") @db.Uuid
  username              String             @unique @db.VarChar(100)
  name                  String             @db.VarChar(100)
  profile_picture       String?            @map("profile_picture")
  bio                   String?
  mother_tongue         String?            @map("mother_tongue") @db.VarChar(50)
  auth_provider         AuthProvider?      @default(local) @map("auth_provider")
  location_city         String?            @map("location_city") @db.VarChar(100)
  location_state        String?            @map("location_state") @db.VarChar(100)
  location_country      String?            @default("India") @map("location_country") @db.VarChar(100)
  phone                 String?            @db.VarChar(20)
  is_phone_verified     Boolean            @default(false) @map("is_phone_verified")
  availability          AvailabilityStatus @default(available)
  categoryId            String?            @map("role_category_id") @db.Uuid
  created_at            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at            DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  cover_banner          String?            @map("cover_banner")
  website               String?            @db.VarChar(255)
  content_interests     String[]           @default([])
  preferences_completed Boolean            @default(false)
  preferred_language    String?            @db.VarChar(50)
  preferred_region      String?            @db.VarChar(100)
  preferred_vibe        String?            @db.VarChar(50)
  category              RoleCategory?      @relation(fields: [categoryId], references: [id])
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles                 UserRoleMapping[]

  @@index([categoryId])
  @@map("user_profiles")
}

model UserFollow {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  created_at  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@map("user_follows")
}

model RoleCategory {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String            @db.VarChar(100)
  slug          String            @unique @db.VarChar(100)
  icon          String?           @db.VarChar(50)
  roleGroup     RoleGroup         @default(PROVIDER) @map("role_group")
  description   String?
  info          String?
  subCategories RoleSubCategory[]
  profiles      UserProfile[]

  @@map("role_categories")
}

model RoleSubCategory {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleCategoryId  String            @map("role_category_id") @db.Uuid
  name            String            @db.VarChar(100)
  slug            String            @db.VarChar(100)
  category        RoleCategory      @relation(fields: [roleCategoryId], references: [id], onDelete: Cascade)
  userRoles       UserRoleMapping[]
  youtubeProfiles YouTubeProfile[]

  @@unique([roleCategoryId, slug])
  @@map("role_sub_categories")
}

model UserRoleMapping {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId         String          @map("profile_id") @db.Uuid
  roleSubCategoryId String          @map("role_sub_category_id") @db.Uuid
  isPrimary         Boolean         @default(false) @map("is_primary")
  profile           UserProfile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  subCategory       RoleSubCategory @relation(fields: [roleSubCategoryId], references: [id], onDelete: Cascade)

  @@unique([profileId, roleSubCategoryId])
  @@index([profileId, isPrimary])
  @@map("user_role_mappings")
}

model UserStats {
  userId          String   @id @map("user_id") @db.Uuid
  followers_count Int      @default(0)
  following_count Int      @default(0)
  created_at      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_stats")
}

model YouTubeProfile {
  id                      String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                  String                   @map("user_id") @db.Uuid
  is_primary              Boolean                  @default(false)
  channel_id              String                   @unique @db.VarChar(255)
  channel_name            String                   @db.VarChar(255)
  subscriber_count        Int?                     @default(0)
  video_count             Int?                     @default(0)
  thumbnail_url           String?
  connected_at            DateTime                 @default(now()) @map("connected_at") @db.Timestamptz(6)
  created_at              DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at              DateTime                 @default(now()) @map("updated_at") @db.Timestamptz(6)
  last_synced_at          DateTime?                @map("last_synced_at") @db.Timestamptz(6)
  uploads_playlist_id     String?                  @map("uploads_playlist_id") @db.VarChar(255)
  video_cache_count       Int                      @default(0) @map("video_cache_count")
  subCategoryId           String?                  @map("sub_category_id") @db.Uuid
  language                String?                  @db.VarChar(50)
  authority_score         Float                    @default(0.0)
  avg_views_per_video     Float                    @default(0.0) @map("avg_views_per_video")
  banner_url              String?
  country                 String?                  @db.VarChar(10)
  custom_url              String?                  @db.VarChar(255)
  description             String?
  engagement_rate         Float                    @default(0.0) @map("engagement_rate")
  hidden_subscriber_count Boolean                  @default(false) @map("hidden_subscriber_count")
  keywords                String?
  made_for_kids           Boolean                  @default(false) @map("made_for_kids")
  published_at            DateTime?                @db.Timestamptz(6)
  search_vector           Unsupported("tsvector")?
  topic_categories        String[]                 @default([]) @map("topic_categories")
  view_count              BigInt?                  @default(0)
  youtube_posts           YoutubePost[]
  subCategory             RoleSubCategory?         @relation(fields: [subCategoryId], references: [id])
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sync_logs               YouTubeSyncLog[]
  videos                  YouTubeVideo[]

  @@map("youtube_profiles")
}

model YouTubeVideo {
  id               String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String?                  @db.Uuid
  channel_id       String                   @db.VarChar(255)
  video_id         String                   @unique @db.VarChar(100)
  title            String                   @db.VarChar(500)
  thumbnail        String?
  published_at     DateTime?                @map("published_at") @db.Timestamptz(6)
  created_at       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at       DateTime                 @default(now()) @map("updated_at") @db.Timestamptz(6)
  is_latest        Boolean                  @default(true)
  position         Int?                     @default(0)
  youtubeProfileId String                   @map("youtube_profile_id") @db.Uuid
  category_id      String?                  @map("category_id") @db.VarChar(10)
  comment_count    BigInt?                  @default(0) @map("comment_count")
  description      String?
  duration_secs    Int?
  like_count       BigInt?                  @default(0) @map("like_count")
  made_for_kids    Boolean                  @default(false) @map("made_for_kids")
  rank_score       Float                    @default(0.0)
  search_vector    Unsupported("tsvector")?
  tags             String?
  view_count       BigInt?                  @default(0)
  user             User?                    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  youtubeProfile   YouTubeProfile           @relation(fields: [youtubeProfileId], references: [id], onDelete: Cascade)

  @@index([channel_id])
  @@index([youtubeProfileId, published_at])
  @@map("youtube_videos")
}

model YouTubeSyncLog {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  youtubeProfileId String         @map("youtube_profile_id") @db.Uuid
  lastSyncedAt     DateTime       @default(now()) @map("last_synced_at") @db.Timestamptz(6)
  status           String         @db.VarChar(20)
  error_message    String?
  youtubeProfile   YouTubeProfile @relation(fields: [youtubeProfileId], references: [id], onDelete: Cascade)

  @@index([youtubeProfileId])
  @@map("youtube_sync_logs")
}

model Notification {
  id         String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String               @map("user_id") @db.Uuid
  senderId   String?              @map("sender_id") @db.Uuid
  type       NotificationType
  priority   NotificationPriority @default(NORMAL)
  entityId   String?              @map("entity_id")
  entityType String?              @map("entity_type")
  title      String               @db.VarChar(255)
  body       String
  image_url  String?              @map("image_url")
  metadata   Json?                @default("{}")
  is_sent    Boolean              @default(false)
  is_read    Boolean              @default(false)
  read_at    DateTime?            @map("read_at")
  is_deleted Boolean              @default(false)
  created_at DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  sender     User?                @relation("TriggeredNotifications", fields: [senderId], references: [id], onDelete: Cascade)
  user       User                 @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, created_at])
  @@index([userId, is_read])
  @@index([entityId, entityType])
  @@map("notifications")
}

model YouTubeQuotaState {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key_name        String   @unique @default("primary")
  daily_limit     Int      @default(10000)
  used_units      Int      @default(0)
  remaining_units Int      @default(10000)
  last_reset_at   DateTime @default(now())
  next_reset_at   DateTime
  updated_at      DateTime @updatedAt

  @@map("youtube_quota_state")
}

model PushToken {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  token        String   @unique
  platform     Platform @default(ANDROID)
  device_name  String?  @map("device_name")
  is_active    Boolean  @default(true)
  last_error   String?  @map("last_error")
  last_used_at DateTime @default(now()) @map("last_used_at")
  created_at   DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

model Message {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sender_id   String   @map("sender_id") @db.Uuid
  receiver_id String   @map("receiver_id") @db.Uuid
  type        String   @default("text") @db.VarChar(20)
  content     String
  is_read     Boolean  @default(false) @map("is_read")
  created_at  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  receiver    User     @relation("MessageReceiver", fields: [receiver_id], references: [id], onDelete: Cascade)
  sender      User     @relation("MessageSender", fields: [sender_id], references: [id], onDelete: Cascade)

  @@index([sender_id])
  @@index([receiver_id])
  @@map("messages")
}

model Post {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String             @map("user_id") @db.Uuid
  caption         String?
  visibility      Visibility         @default(PUBLIC)
  created_at      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at      DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  allow_comments  Boolean            @default(true)
  audio_track_id  String?            @db.Uuid
  comment_count   Int                @default(0) @map("comment_count")
  hide_like_count Boolean            @default(false)
  is_ready        Boolean            @default(false)
  is_scheduled    Boolean            @default(false)
  like_count      Int                @default(0) @map("like_count")
  location_lat    Float?
  location_lng    Float?
  location_name   String?
  scheduled_at    DateTime?          @db.Timestamptz(6)
  comments        Comment[]
  media           Media[]
  collaborators   PostCollaborator[]
  likes           PostLike[]
  mentions        PostMention[]
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, created_at])
  @@map("posts")
}

model PostCollaborator {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId     String       @map("post_id") @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  status     CollabStatus @default(PENDING)
  created_at DateTime     @default(now()) @db.Timestamptz(6)
  post       Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_collaborators")
}

model PostMention {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId String @map("post_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_mentions")
}

model Reel {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String     @map("user_id") @db.Uuid
  caption       String?
  visibility    Visibility @default(PUBLIC)
  is_ready      Boolean    @default(false)
  like_count    Int        @default(0) @map("like_count")
  comment_count Int        @default(0) @map("comment_count")
  view_count    Int        @default(0) @map("view_count")
  created_at    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at    DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  comments      Comment[]
  media         Media[]
  likes         ReelLike[]
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, created_at])
  @@map("reels")
}

model YoutubePost {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String            @map("user_id") @db.Uuid
  youtube_channel_id String?           @map("youtube_channel_id") @db.Uuid
  caption            String?
  youtube_link       String
  visibility         Visibility        @default(PUBLIC)
  is_ready           Boolean           @default(false)
  like_count         Int               @default(0) @map("like_count")
  comment_count      Int               @default(0) @map("comment_count")
  created_at         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at         DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  comments           Comment[]
  media              Media[]
  likes              YoutubePostLike[]
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  youtube_channel    YouTubeProfile?   @relation(fields: [youtube_channel_id], references: [id])

  @@index([userId, created_at])
  @@index([youtube_channel_id])
  @@map("youtube_posts")
}

model Media {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId            String?            @map("post_id") @db.Uuid
  userId            String             @map("user_id") @db.Uuid
  type              MediaType          @default(IMAGE)
  storageKey        String             @map("storage_key")
  mimeType          String?            @map("mime_type")
  size              Int?
  width             Int?
  height            Int?
  duration          Int?
  variants          Json?
  blurhash          String?
  status            MediaStatus        @default(PENDING)
  created_at        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  alt_text          String?
  hash              String?            @db.VarChar(64)
  order_index       Int                @default(0)
  reelId            String?            @map("reel_id") @db.Uuid
  storage_provider  String             @default("S3") @map("storage_provider")
  youtubePostId     String?            @map("youtube_post_id") @db.Uuid
  communityMessages CommunityMessage[]
  post              Post?              @relation(fields: [postId], references: [id], onDelete: Cascade)
  reel              Reel?              @relation(fields: [reelId], references: [id], onDelete: Cascade)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  youtubePost       YoutubePost?       @relation(fields: [youtubePostId], references: [id], onDelete: Cascade)
  user_tags         MediaUserTag[]
  poll_option       PollOption?
  story             Story?

  @@index([postId])
  @@index([reelId])
  @@index([youtubePostId])
  @@index([userId])
  @@map("media")
}

model MediaUserTag {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mediaId String @map("media_id") @db.Uuid
  userId  String @map("user_id") @db.Uuid
  pos_x   Float
  pos_y   Float
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("media_user_tags")
}

model Story {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String      @map("user_id") @db.Uuid
  mediaId          String      @unique @map("media_id") @db.Uuid
  caption          String?
  expires_at       DateTime    @map("expires_at") @db.Timestamptz(6)
  is_archived      Boolean     @default(false) @map("is_archived")
  view_count       Int         @default(0) @map("view_count")
  visibility       Visibility  @default(PUBLIC)
  metadata         Json?       @default("{}")
  canvas_width     Float?      @map("canvas_width")
  canvas_height    Float?      @map("canvas_height")
  bg_media_type    String?     @map("bg_media_type")
  bg_media_url     String?     @map("bg_media_url")
  bg_thumb_url     String?     @map("bg_thumb_url")
  bg_blurhash      String?     @map("bg_blurhash")
  display_duration Int         @default(10) @map("display_duration")
  created_at       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  media            Media       @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  views            StoryView[]

  @@index([userId, expires_at])
  @@index([expires_at])
  @@map("stories")
}

model StoryView {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storyId   String   @map("story_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  viewed_at DateTime @default(now()) @map("viewed_at") @db.Timestamptz(6)
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
  @@map("story_views")
}

model AdminRole {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String        @db.VarChar(100)
  value        String        @unique @db.VarChar(50)
  description  String?       @default("")
  color        String?       @default("#1d4ed8") @db.VarChar(20)
  permissions  Json          @default("{}")
  is_active    Boolean?      @default(true) @map("is_active")
  is_system    Boolean?      @default(false) @map("is_system")
  member_count Int?          @default(0) @map("member_count")
  created_at   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  members      AdminMember[]

  @@map("admin_roles")
}

model AdminMember {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                  String             @unique @db.VarChar(255)
  password_hash          String             @map("password_hash")
  password               String?            @db.VarChar(255)
  name                   String             @db.VarChar(100)
  role_id                String?            @map("role_id") @db.Uuid
  role_value             String?            @default("admin") @map("role_value") @db.VarChar(50)
  profile_image          String?            @map("profile_image")
  permissions            Json?              @default("{}")
  is_active              Boolean?           @default(true) @map("is_active")
  last_login             DateTime?          @map("last_login") @db.Timestamptz(6)
  last_login_ip          String?            @map("last_login_ip") @db.Inet
  login_attempts         Int?               @default(0) @map("login_attempts") @db.SmallInt
  locked_until           DateTime?          @map("locked_until") @db.Timestamptz(6)
  current_session_token  String?            @map("current_session_token")
  password_reset_token   String?            @map("password_reset_token")
  password_reset_expires DateTime?          @map("password_reset_expires") @db.Timestamptz(6)
  password_changed_at    DateTime?          @map("password_changed_at") @db.Timestamptz(6)

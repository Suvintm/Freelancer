  clicks         Int      @default(0)
  uniqueVisitors Int      @default(0) @map("unique_visitors")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  page           BioPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, date])
  @@index([pageId, date])
  @@map("bio_daily_stats")
}

model BioAnalyticsEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pageId     String   @map("page_id") @db.Uuid
  eventType  String   @map("event_type") @db.VarChar(50) // 'view' | 'click' | 'subscribe'
  blockId    String?  @map("block_id") @db.VarChar(100)
  visitorId  String?  @map("visitor_id") @db.VarChar(255)
  referrer   String?  @db.VarChar(255)
  device     String?  @db.VarChar(50)
  country    String?  @db.VarChar(10)
  ipHash     String?  @map("ip_hash") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  page       BioPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, createdAt])
  @@index([pageId, eventType])
  @@map("bio_analytics_events")
}

model BioSubscriber {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pageId      String   @map("page_id") @db.Uuid
  email       String   @db.VarChar(255)
  source      String?  @default("email-capture") @db.VarChar(100)
  sourceBlock String?  @map("source_block") @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  page        BioPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, email])
  @@index([pageId])
  @@map("bio_subscribers")
}

model BioTemplate {
  id          String   @id @db.VarChar(100)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  category    String   @default("creators") @db.VarChar(50) // 'creators' | 'music' | 'business' | 'minimal' | 'ecommerce'
  tier        String   @default("free") @db.VarChar(20) // 'free' | 'pro'
  thumbnail   String?  @db.Text
  themeJson   Json     @map("theme_json")
  blocksJson  Json     @map("blocks_json")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([category, isActive])
  @@map("bio_templates")
}

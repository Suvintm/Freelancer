generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username                  String?                    @unique @db.VarChar(100)
  email                     String                     @unique @db.VarChar(255)
  password_hash             String?                    @map("password_hash")
  role                      UserRole                   @default(user)
  auth_provider             AuthProvider?              @default(local) @map("auth_provider")
  google_id                 String?                    @unique @map("google_id") @db.VarChar(255)
  token_version             Int                        @default(0) @map("token_version")
  is_verified               Boolean                    @default(false) @map("is_verified")
  is_email_verified         Boolean                    @default(false) @map("is_email_verified")
  email_verified_at         DateTime?                  @map("email_verified_at") @db.Timestamptz(6)
  is_banned                 Boolean                    @default(false) @map("is_banned")
  ban_reason                String?                    @map("ban_reason")
  login_attempts            Int                        @default(0) @map("login_attempts")
  locked_until              DateTime?                  @map("locked_until") @db.Timestamptz(6)
  is_onboarded              Boolean                    @default(false) @map("is_onboarded")
  last_login_at             DateTime?                  @map("last_login_at") @db.Timestamptz(6)
  deleted_at                DateTime?                  @map("deleted_at") @db.Timestamptz(6)
  created_at                DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at                DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  bioPages                  BioPage[]
  brandProfile              BrandProfile?
  comment_likes             CommentLike[]
  comments                  Comment[]                  @relation("UserComments")
  communities_owned         Community[]                @relation("CommunityOwner")
  memberships               CommunityMember[]
  communityMessageReactions CommunityMessageReaction[]
  community_messages        CommunityMessage[]
  communityPostReactions    CommunityPostReaction[]    @relation("CommunityPostReactionUser")
  communityPostsAuthored    CommunityPost[]            @relation("CommunityPostAuthor")
  creatorProfile            CreatorProfile?
  editorProfile             EditorProfile?
  instagramProfile          InstagramProfile?
  media                     Media[]
  media_user_tags           MediaUserTag[]
  received_messages         Message[]                  @relation("MessageReceiver")
  sent_messages             Message[]                  @relation("MessageSender")
  triggeredNotifications    Notification[]             @relation("TriggeredNotifications")
  notifications             Notification[]             @relation("UserNotifications")
  paymentsAsClient          Payment[]                  @relation("ClientPayments")
  paymentsAsEditor          Payment[]                  @relation("EditorPayments")
  poll_likes                PollLike[]
  poll_responses            PollResponse[]
  polls                     Poll[]
  post_collaborations       PostCollaborator[]
  post_likes                PostLike[]
  post_mentions             PostMention[]
  posts                     Post[]
  publicProfile             PublicProfile?
  pushTokens                PushToken[]
  recommendation_logs       RecommendationLog[]
  reel_likes                ReelLike[]
  reels                     Reel[]
  stories                   Story[]
  story_views               StoryView[]
  content_affinities        UserContentAffinity[]
  follows                   UserFollow[]               @relation("Follower")
  following                 UserFollow[]               @relation("Following")
  profile                   UserProfile?
  stats                     UserStats?
  youtube_post_likes        YoutubePostLike[]
  youtube_posts             YoutubePost[]
  youtubeProfile            YouTubeProfile?
  youtube_videos            YouTubeVideo[]

  @@index([role])
  @@index([is_onboarded])
  @@index([created_at(sort: Desc)])
  @@index([deleted_at])
  @@map("users")
}

model UserProfile {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String             @unique @map("user_id") @db.Uuid
  username              String             @unique @db.VarChar(100)
  name                  String             @db.VarChar(100)
  profile_picture       String?            @map("profile_picture")
  cover_banner          String?            @map("cover_banner")
  bio                   String?
  gender                String?            @db.VarChar(20)
  date_of_birth         DateTime?          @db.Date
  mother_tongue         String?            @map("mother_tongue") @db.VarChar(50)
  location_city         String?            @map("location_city") @db.VarChar(100)
  location_state        String?            @map("location_state") @db.VarChar(100)
  location_country      String?            @default("India") @map("location_country") @db.VarChar(100)
  phone                 String?            @db.VarChar(20)
  is_phone_verified     Boolean            @default(false) @map("is_phone_verified")
  website               String?            @db.VarChar(255)
  social_links          Json?              @default("{}")
  availability          AvailabilityStatus @default(available)
  categoryId            String?            @map("role_category_id") @db.Uuid
  content_interests     String[]           @default([])
  preferences_completed Boolean            @default(false)
  preferred_language    String?            @db.VarChar(50)
  preferred_region      String?            @db.VarChar(100)
  preferred_vibe        String?            @db.VarChar(50)
  qr_generated          Boolean            @default(false) @map("qr_generated")
  qr_svg_url            String?            @map("qr_svg_url")
  qr_png_url            String?            @map("qr_png_url")
  qr_version            Int                @default(0) @map("qr_version")
  qr_generated_at       DateTime?          @map("qr_generated_at") @db.Timestamptz(6)
  created_at            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at            DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  category              RoleCategory?      @relation(fields: [categoryId], references: [id])
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([availability])
  @@index([location_country, location_city])
  @@map("user_profiles")
}

model EditorProfile {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String   @unique @map("user_id") @db.Uuid
  portfolio_url        String?  @map("portfolio_url") @db.VarChar(255)
  showcase_video_urls  String[] @default([]) @map("showcase_video_urls")
  experience_years     Int      @default(0) @map("experience_years")
  skills               String[] @default([])
  software_used        String[] @default([]) @map("software_used")
  specializations      String[] @default([]) @map("specializations")
  accepting_orders     Boolean  @default(true) @map("accepting_orders")
  turnaround_time_days Int      @default(3) @map("turnaround_time_days")
  rate_currency        String   @default("INR") @map("rate_currency") @db.VarChar(10)
  hourly_rate          Decimal? @map("hourly_rate") @db.Decimal(12, 2)
  base_video_rate      Decimal? @map("base_video_rate") @db.Decimal(12, 2)
  rate_per_short       Decimal? @map("rate_per_short") @db.Decimal(12, 2)
  avg_rating           Float    @default(0.0) @map("avg_rating")
  review_count         Int      @default(0) @map("review_count")
  completed_gigs       Int      @default(0) @map("completed_gigs")
  created_at           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([accepting_orders])
  @@index([experience_years])
  @@index([base_video_rate])
  @@index([avg_rating(sort: Desc)])
  @@map("editor_profiles")
}

model BrandProfile {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  company_name      String?  @map("company_name") @db.VarChar(100)
  company_website   String?  @map("company_website") @db.VarChar(255)
  logo_url          String?  @map("logo_url")
  industry          String?  @db.VarChar(100)
  company_size      String?  @map("company_size") @db.VarChar(50)
  designation       String?  @db.VarChar(100)
  brand_description String?  @map("brand_description")
  target_regions    String[] @default([]) @map("target_regions")
  is_verified       Boolean  @default(false) @map("is_verified")
  budget_currency   String   @default("INR") @map("budget_currency") @db.VarChar(10)
  approx_budget     Decimal? @map("approx_budget") @db.Decimal(14, 2)
  campaigns_posted  Int      @default(0) @map("campaigns_posted")
  total_spent       Decimal? @map("total_spent") @db.Decimal(14, 2)
  created_at        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([industry])
  @@index([is_verified])
  @@map("brand_profiles")
}

model UserFollow {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  created_at  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@map("user_follows")
}

model RoleCategory {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String        @db.VarChar(100)
  slug          String        @unique @db.VarChar(100)
  icon          String?       @db.VarChar(50)
  maps_to_role  UserRole      @default(user) @map("maps_to_role")
  description   String?
  info          String?
  is_active     Boolean       @default(true) @map("is_active")
  display_order Int           @default(0) @map("display_order")
  profiles      UserProfile[]

  @@map("role_categories")
}

model UserStats {
  userId          String   @id @map("user_id") @db.Uuid
  followers_count Int      @default(0)
  following_count Int      @default(0)
  created_at      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_stats")
}

model CreatorProfile {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                 String   @unique @map("user_id") @db.Uuid
  business_email         String?  @map("business_email") @db.VarChar(255)
  accepting_sponsorships Boolean  @default(true) @map("accepting_sponsorships")
  rate_currency          String   @default("INR") @map("rate_currency") @db.VarChar(10)
  rate_dedicated_video   Decimal? @map("rate_dedicated_video") @db.Decimal(12, 2)
  rate_integrated_video  Decimal? @map("rate_integrated_video") @db.Decimal(12, 2)
  rate_short             Decimal? @map("rate_short") @db.Decimal(12, 2)
  created_at             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at             DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([accepting_sponsorships])
  @@map("creator_profiles")
}

model YouTubeProfile {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String           @unique @map("user_id") @db.Uuid
  access_token     String?          @map("access_token")
  refresh_token    String?          @map("refresh_token")
  token_expires_at DateTime?        @map("token_expires_at") @db.Timestamptz(6)
  scopes           String[]         @default([])
  status           PlatformStatus   @default(LINKED)
  sync_status      SyncStatus       @default(idle)
  last_synced_at   DateTime?        @map("last_synced_at") @db.Timestamptz(6)
  connected_at     DateTime?        @map("connected_at") @db.Timestamptz(6)
  created_at       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  channels         YouTubeChannel[]
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("youtube_profiles")
}

model YouTubeChannel {
  id                      String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  youtubeProfileId        String           @map("youtube_profile_id") @db.Uuid
  userId                  String           @map("user_id") @db.Uuid
  channel_id              String           @unique @map("channel_id") @db.VarChar(255)
  channel_name            String           @map("channel_name") @db.VarChar(255)
  custom_url              String?          @unique @map("custom_url") @db.VarChar(255)
  description             String?
  thumbnail_url           String?          @map("thumbnail_url")
  banner_url              String?          @map("banner_url")
  country                 String?          @db.VarChar(10)
  language                String?          @db.VarChar(10)
  niche                   String?          @db.VarChar(100)
  subscriber_count        BigInt           @default(0) @map("subscriber_count")
  video_count             Int              @default(0) @map("video_count")
  view_count              BigInt           @default(0) @map("view_count")
  avg_views               Float            @default(0.0) @map("avg_views")
  engagement_rate         Float            @default(0.0) @map("engagement_rate")
  authority_score         Float            @default(0.0) @map("authority_score")
  published_at            DateTime?        @map("published_at") @db.Timestamptz(6)
  hidden_subscriber_count Boolean          @default(false) @map("hidden_subscriber_count")
  topic_categories        String[]         @default([]) @map("topic_categories")
  keywords                String?          @map("keywords")
  last_synced_at          DateTime?        @map("last_synced_at") @db.Timestamptz(6)
  sync_status             SyncStatus       @default(idle) @map("sync_status")
  uploads_playlist_id     String?          @map("uploads_playlist_id") @db.VarChar(100)
  made_for_kids           Boolean          @default(false) @map("made_for_kids")
  is_primary              Boolean          @default(false) @map("is_primary")
  is_verified             Boolean          @default(false) @map("is_verified")
  status                  ChannelStatus    @default(active)
  created_at              DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at              DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  community               Community?
  youtubeProfile          YouTubeProfile   @relation(fields: [youtubeProfileId], references: [id], onDelete: Cascade)
  youtube_posts           YoutubePost[]
  sync_logs               YouTubeSyncLog[]
  videos                  YouTubeVideo[]

  @@index([userId])
  @@index([subscriber_count(sort: Desc)])
  @@index([niche])
  @@index([country, language])
  @@index([authority_score(sort: Desc)])
  @@map("youtube_channels")
}

model InstagramProfile {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String             @unique @map("user_id") @db.Uuid
  access_token     String?            @map("access_token")
  refresh_token    String?            @map("refresh_token")
  token_expires_at DateTime?          @map("token_expires_at") @db.Timestamptz(6)
  scopes           String[]           @default([])
  status           PlatformStatus     @default(LINKED)
  sync_status      SyncStatus         @default(idle)
  last_synced_at   DateTime?          @map("last_synced_at") @db.Timestamptz(6)
  connected_at     DateTime?          @map("connected_at") @db.Timestamptz(6)
  created_at       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  accounts         InstagramAccount[]
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("instagram_profiles")
}

model InstagramAccount {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  instagramProfileId  String             @map("instagram_profile_id") @db.Uuid
  userId              String             @map("user_id") @db.Uuid
  account_id          String             @unique @map("account_id") @db.VarChar(255)
  username            String             @unique @db.VarChar(255)
  display_name        String?            @map("display_name") @db.VarChar(255)
  biography           String?
  profile_picture_url String?            @map("profile_picture_url")
  website             String?            @db.VarChar(500)
  account_type        String?            @map("account_type") @db.VarChar(50)
  business_category   String?            @map("business_category") @db.VarChar(100)
  country             String?            @db.VarChar(10)
  followers_count     Int                @default(0) @map("followers_count")
  following_count     Int                @default(0) @map("following_count")
  media_count         Int                @default(0) @map("media_count")
  avg_likes           Float              @default(0.0) @map("avg_likes")
  engagement_rate     Float              @default(0.0) @map("engagement_rate")
  is_primary          Boolean            @default(false) @map("is_primary")
  is_verified         Boolean            @default(false) @map("is_verified")
  created_at          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at          DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  community           Community?
  instagramProfile    InstagramProfile   @relation(fields: [instagramProfileId], references: [id], onDelete: Cascade)
  posts               InstagramPost[]
  instagramSyncLogs   InstagramSyncLog[]

  @@index([userId])
  @@index([followers_count(sort: Desc)])
  @@index([engagement_rate(sort: Desc)])
  @@map("instagram_accounts")
}

model InstagramPost {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  instagramAccountId String           @map("instagram_account_id") @db.Uuid
  userId             String           @map("user_id") @db.Uuid
  post_id            String           @unique @map("post_id") @db.VarChar(255)
  media_type         String           @map("media_type") @db.VarChar(50)
  media_url          String?          @map("media_url")
  thumbnail_url      String?          @map("thumbnail_url")
  permalink          String?          @db.VarChar(500)
  caption            String?
  timestamp          DateTime?        @db.Timestamptz(6)
  like_count         Int              @default(0) @map("like_count")
  comment_count      Int              @default(0) @map("comment_count")
  view_count         Int?             @map("view_count")
  reach              Int?
  impressions        Int?
  created_at         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  instagramAccount   InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@index([instagramAccountId, timestamp])
  @@index([userId])
  @@map("instagram_posts")
}

model InstagramSyncLog {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  instagramAccountId String           @map("instagram_account_id") @db.Uuid
  lastSyncedAt       DateTime         @default(now()) @map("last_synced_at") @db.Timestamptz(6)
  status             SyncStatus       @default(idle)
  error_message      String?
  instagramAccount   InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@index([instagramAccountId])
  @@map("instagram_sync_logs")
}

model YouTubeVideo {
  id               String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String?                  @db.Uuid
  channel_id       String                   @db.VarChar(255)
  video_id         String                   @unique @db.VarChar(100)
  title            String                   @db.VarChar(500)
  thumbnail        String?
  published_at     DateTime?                @map("published_at") @db.Timestamptz(6)
  created_at       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at       DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  is_latest        Boolean                  @default(true)
  position         Int?                     @default(0)
  youtubeChannelId String                   @map("youtube_channel_id") @db.Uuid
  category_id      String?                  @map("category_id") @db.VarChar(10)
  comment_count    BigInt?                  @default(0) @map("comment_count")
  description      String?
  duration_secs    Int?
  like_count       BigInt?                  @default(0) @map("like_count")
  made_for_kids    Boolean                  @default(false) @map("made_for_kids")
  rank_score       Float                    @default(0.0)
  search_vector    Unsupported("tsvector")?
  tags             String?
  view_count       BigInt?                  @default(0)
  user             User?                    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  youtubeChannel   YouTubeChannel           @relation(fields: [youtubeChannelId], references: [id], onDelete: Cascade)

  @@index([channel_id])
  @@index([youtubeChannelId, published_at])
  @@map("youtube_videos")
}

model YouTubeSyncLog {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  youtubeChannelId String         @map("youtube_channel_id") @db.Uuid
  lastSyncedAt     DateTime       @default(now()) @map("last_synced_at") @db.Timestamptz(6)
  status           SyncStatus     @default(idle)
  error_message    String?
  youtubeChannel   YouTubeChannel @relation(fields: [youtubeChannelId], references: [id], onDelete: Cascade)

  @@index([youtubeChannelId])
  @@map("youtube_sync_logs")
}

model Notification {
  id         String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String               @map("user_id") @db.Uuid
  senderId   String?              @map("sender_id") @db.Uuid
  type       NotificationType
  priority   NotificationPriority @default(NORMAL)
  entityId   String?              @map("entity_id")
  entityType String?              @map("entity_type")
  title      String               @db.VarChar(255)
  body       String
  image_url  String?              @map("image_url")
  metadata   Json?                @default("{}")
  is_sent    Boolean              @default(false)
  is_read    Boolean              @default(false)
  read_at    DateTime?            @map("read_at")
  is_deleted Boolean              @default(false)
  created_at DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  sender     User?                @relation("TriggeredNotifications", fields: [senderId], references: [id], onDelete: Cascade)
  user       User                 @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, created_at])
  @@index([userId, is_read])
  @@index([entityId, entityType])
  @@map("notifications")
}

model YouTubeQuotaState {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key_name        String   @unique @default("primary")
  daily_limit     Int      @default(10000)
  used_units      Int      @default(0)
  remaining_units Int      @default(10000)
  last_reset_at   DateTime @default(now())
  next_reset_at   DateTime
  updated_at      DateTime @updatedAt

  @@map("youtube_quota_state")
}

model InstagramQuotaState {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key_name        String   @unique @default("primary")
  daily_limit     Int      @default(200)
  used_calls      Int      @default(0)
  remaining_calls Int      @default(200)
  last_reset_at   DateTime @default(now())
  next_reset_at   DateTime
  updated_at      DateTime @updatedAt

  @@map("instagram_quota_state")
}

model PushToken {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  token        String   @unique
  platform     Platform @default(ANDROID)
  device_name  String?  @map("device_name")
  is_active    Boolean  @default(true)
  last_error   String?  @map("last_error")
  last_used_at DateTime @default(now()) @map("last_used_at")
  created_at   DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

model Message {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sender_id   String   @map("sender_id") @db.Uuid
